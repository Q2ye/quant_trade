{
  "skills": ["quantsys-architect", "strategy-dev", "strategy-auditor", "frontend-craft", "strategy-review"],
  "_comment": "写入守卫的逻辑集中在 .claude/hooks/*.py（便于测试与评审），此处只做接线。2026-09-15 修 4 个可绕过的口子，详见 hooks/guard.py docstring。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" pre_write",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan_incoming.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" pre_bash",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python -c \"import sys,json; cmd=json.load(sys.stdin)['tool_input']['command']; sys.exit(2 if cmd.strip().startswith('git push') and ('master' in cmd or 'main' in cmd) else 0)\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan_credentials.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_on_edit.py\"",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT_FILE_PATH\" | grep -qE '\\.py$'; then cd \"$CLAUDE_PROJECT_DIR/quant_server\" && python -m ruff format \"$CLAUDE_TOOL_INPUT_FILE_PATH\" --quiet 2>/dev/null; fi",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
