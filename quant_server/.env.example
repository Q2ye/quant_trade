# ---------------------------------------------------------------------------
# 环境变量模板（复制为 quant_server/.env 后按需填写；.env 已被 git 忽略）
# 数据库选择只认 ENVIRONMENT：development → DB_*，其它 → PROD_DB_*
# 启动时 --mode 会覆盖 ENVIRONMENT（见 quant_server/main.py）
# ---------------------------------------------------------------------------

ENVIRONMENT=development
APP_NAME=一念量化
APP_VERSION=1.0.0

# 开发库（ENVIRONMENT=development 时生效）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=quant_signals_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DEV_DATA_MODE=real
DEV_MOCK_DATA_ENABLED=false

# 生产库（ENVIRONMENT=production 时生效）
PROD_DB_HOST=localhost
PROD_DB_PORT=5432
PROD_DB_USER=postgres
PROD_DB_PASSWORD=change-me
PROD_DB_NAME=quant_signals
PROD_DB_POOL_SIZE=10
PROD_DATA_MODE=real
PROD_TUSHARE_TOKEN=your_tushare_token
PROD_TUSHARE_ENABLED=true

SECRET_KEY=change-me-to-a-random-string
LOG_LEVEL=INFO

# 只影响日志与 API 展示，不是执行开关（见 AGENTS.md 安全红线）
SIMULATED_TRADING=true

WECHAT_WEBHOOK_URL=
