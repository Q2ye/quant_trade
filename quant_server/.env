# ==================== 环境配置 ====================
# 可选值: development, production
# 开发环境(quant_signals_dev): 使用模拟数据
# 生产环境(quant_signals): 使用真实数据源
ENVIRONMENT=development

APP_NAME=量化交易平台
APP_VERSION=1.0.0

# ==================== 数据库配置 ====================
# 开发环境数据库 (quant_signals_dev)
DB_DEV_HOST=localhost
DB_DEV_PORT=5432
DB_DEV_USER=postgres
DB_DEV_PASSWORD=123456
DB_DEV_NAME=quant_signals_dev
DB_DEV_POOL_SIZE=10

# 生产环境数据库 (quant_signals)
DB_PROD_HOST=localhost
DB_PROD_PORT=5432
DB_PROD_USER=postgres
DB_PROD_PASSWORD=123456
DB_PROD_NAME=quant_signals
DB_PROD_POOL_SIZE=20

# 当前使用的数据库配置（由 ENVIRONMENT 环境变量决定）
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO_SQL=false
DB_ECHO_POOL=false

# ==================== API配置 ====================
APP_DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# ==================== Redis配置 ====================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 数据源配置 ====================
# 开发环境：使用模拟数据，无需 TUSHARE_TOKEN
# 生产环境：需要真实的 TUSHARE_TOKEN
# 可选值: simulated, real
DATA_MODE=simulated

# 模拟数据配置
MOCK_DATA_ENABLED=true
MOCK_STOCK_COUNT=50
MOCK_DATE_RANGE_DAYS=90

# 模拟股票代码（A股常用股票）
MOCK_STOCK_CODES=000001.SZ,600000.SH,600519.SH,000002.SZ,000333.SZ,601318.SH,601398.SH,600036.SH,000651.SZ,300750.SZ

# Tushare配置（仅生产环境使用）
TUSHARE_TOKEN=
TUSHARE_ENABLED=false

# ==================== 交易配置 ====================
SIMULATED_TRADING=true
SIM_INITIAL_CAPITAL=1000000
BROKER=simulation
MAX_POSITION_RATIO=0.8
STOP_LOSS_PERCENT=0.1

# ==================== 通知配置 ====================
EMAIL_ENABLED=false
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_RECEIVERS=

DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token

WECHAT_ENABLED=false
WECHAT_CORP_ID=your_corp_id
WECHAT_CORP_SECRET=your_corp_secret
WECHAT_AGENT_ID=1000001

# ==================== 日志配置 ====================
LOG_LEVEL=DEBUG
