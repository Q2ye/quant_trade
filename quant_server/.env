# ===== 核心环境配置 =====
ENVIRONMENT=development
APP_NAME=一念量化
APP_VERSION=1.0.0

# ===== 开发环境配置 =====
# 数据库
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_USER=postgres
DEV_DB_PASSWORD=123456
DEV_DB_NAME=quant_signals_dev
DEV_DB_POOL_SIZE=10

# 数据源
DEV_DATA_MODE=simulated
DEV_MOCK_DATA_ENABLED=true
DEV_MOCK_STOCK_COUNT=50
DEV_MOCK_DATE_RANGE_DAYS=90
DEV_MOCK_STOCK_CODES=000001.SZ,600000.SH,600519.SH,000002.SZ,000333.SZ,601318.SH,601398.SH,600036.SH,000651.SZ,300750.SZ

# ===== 生产环境配置 =====
# 数据库
PROD_DB_HOST=localhost
PROD_DB_PORT=5432
PROD_DB_USER=postgres
PROD_DB_PASSWORD=123456
PROD_DB_NAME=quant_signals
PROD_DB_POOL_SIZE=20

# 数据源
PROD_DATA_MODE=real
PROD_TUSHARE_TOKEN=
PROD_TUSHARE_ENABLED=false

# ===== 通用安全配置 =====
SECRET_KEY=your-secret-key-here-change-in-production

# ===== 运行时覆盖配置 =====
# 以下配置会覆盖对应环境的默认值
LOG_LEVEL=DEBUG
SIMULATED_TRADING=true