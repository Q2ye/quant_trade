# ==============================================================================
# 量化交易系统 — 环境变量配置文件
# ==============================================================================
# 本文件由 ConfigManager 在启动时加载（pydantic-settings 自动解析）。
# 命名规则：
#   - DEV_*  前缀 = 开发环境专用（ENVIRONMENT=development 时生效）
#   - PROD_* 前缀 = 生产环境专用（ENVIRONMENT=production 时生效）
#   - 无前缀的键为通用配置，所有环境共用
# 值类型：字符串无需引号，布尔用 true/false，数字直接写
# ==============================================================================

# ==============================================================================
# 核心环境配置
# ==============================================================================

# 运行环境：development（开发）/ production（生产）/ testing（测试）
# 决定加载 DEV_* 还是 PROD_* 前缀的配置项
ENVIRONMENT=development

# 应用显示名称（前端页面标题、日志标识等）
APP_NAME=一念量化

# 应用版本号（API 文档、健康检查、日志中展示）
APP_VERSION=1.0.0
# ==============================================================================
# 开发环境 — 数据库配置
# ==============================================================================
# 仅在 ENVIRONMENT=development 时生效
# 开发库名默认为 quant_signals_dev，与生产库隔离，避免误操作

# 数据库主机地址（localhost = 本机，远程数据库填 IP 或域名）
DB_HOST=localhost

# 数据库端口（PostgreSQL 默认 5432，如使用其他端口需同步修改数据库服务配置）
DB_PORT=5432

# 数据库用户名
DB_USER=postgres

# 数据库密码（开发环境可简单，生产环境务必使用强密码）
DB_PASSWORD=123456

# 数据库名称（开发环境使用独立库，结构与生产一致但数据隔离）
DB_NAME=quant_signals_dev

# 连接池大小（开发环境并发低，10 足够；生产环境建议 20-50）
DB_POOL_SIZE=20
# 连接池溢出上限（同步高峰期可超出 pool_size 的连接数）
DB_MAX_OVERFLOW=5

# ==============================================================================
# 开发环境 — 数据源配置
# ==============================================================================
# 仅在 ENVIRONMENT=development 时生效
# Token 优先读 DEV_TUSHARE_TOKEN，为空时自动回退 PROD_TUSHARE_TOKEN

# 数据模式：real（真实数据源，如 Tushare）/ simulated（模拟数据，使用 MockSource）
# real 模式需要配置有效的 Tushare Token 才能获取数据
DEV_DATA_MODE=real

# 是否启用模拟数据：true（启用，API 返回随机生成的假数据）/ false（关闭，走真实数据源）
# 仅在 DEV_DATA_MODE=simulated 或后端无真实数据时才会用到
DEV_MOCK_DATA_ENABLED=false

# 模拟股票数量（启用模拟数据时，生成多少只模拟股票）
DEV_MOCK_STOCK_COUNT=50

# 模拟数据的日期范围（天数，从当前日期往前推算）
DEV_MOCK_DATE_RANGE_DAYS=90

# 模拟数据的股票代码列表（逗号分隔，.SZ=深交所 .SH=上交所）
# 仅在启用模拟数据时有意义，真实模式下忽略
DEV_MOCK_STOCK_CODES=000001.SZ,600000.SH,600519.SH,000002.SZ,000333.SZ,601318.SH,601398.SH,600036.SH,000651.SZ,300750.SZ

# ==============================================================================
# 生产环境 — 数据库配置
# ==============================================================================
# 仅在 ENVIRONMENT=production 时生效
# 生产环境请务必修改默认密码，使用强密码并限制网络访问

# 注意：生产环境使用 PROD_DB_* 前缀，当前 ENVIRONMENT=development 时不会加载
# 如需部署生产环境，请将下方 PROD_DB_* 改为 DB_* 并更新值
PROD_DB_HOST=localhost
PROD_DB_PORT=5432
PROD_DB_USER=postgres
PROD_DB_PASSWORD=123456
PROD_DB_NAME=quant_signals
PROD_DB_POOL_SIZE=20
# ==============================================================================
# 生产环境 — 数据源配置
# ==============================================================================
# 仅在 ENVIRONMENT=production 时生效
# 生产数据模式：生产环境必须设为 real，不可使用模拟数据
PROD_DATA_MODE=real
# Tushare Pro API Token
# 获取方式：https://tushare.pro → 注册 → 用户中心 → 接口TOKEN
# 积分规则：120 免费积分 + 捐款获取额外积分（2000分=¥200 / 8000分=¥800）
# 8000 积分可调用全部 ETF + A 股基础数据接口（含 fund_basic）
# 注意：Token 是敏感信息，不要提交到公开仓库
PROD_TUSHARE_TOKEN=461a33c492dcfde47bbd2e87f67bd174399f354d34249d775809638b
# 是否启用 Tushare 数据源：true（启用，启动时初始化 TushareSource）/ false（禁用）
# 禁用后数据同步和行情查询将无法获取真实数据
PROD_TUSHARE_ENABLED=true
# ==============================================================================
# 通用安全配置（所有环境共用）
# ==============================================================================

# JWT 签名密钥 — 用于生成和验证用户登录 Token
# 开发环境可用简单值，生产环境务必修改为 32+ 位随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production
# ==============================================================================
# 运行时覆盖配置（所有环境共用，覆盖模块默认值）
# ==============================================================================
# 日志级别：DEBUG（最详细）/ INFO（常规）/ WARNING（警告及以上）/ ERROR（仅错误）
# 开发建议 DEBUG，生产建议 INFO 或 WARNING
LOG_LEVEL=INFO
# 模拟交易模式：true（所有交易指令不真正发往交易所，只记录日志）/ false（真实下单）
# 开发/测试环境必须设为 true，避免误操作产生真实交易
SIMULATED_TRADING=true

WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=a5933733-23bc-4e0c-b245-7326b1e237a5

