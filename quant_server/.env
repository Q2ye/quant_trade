# 数据库配置
DB_TYPE=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=quant_signals
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO

# 数据源配置
TUSHARE_TOKEN=your_tushare_token
TUSHARE_TIMEOUT=30
BAOSTOCK_USER=your_baostock_user
BAOSTOCK_PASSWORD=your_baostock_password

# 通知配置
EMAIL_ENABLED=false
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_RECEIVERS=user1@example.com,user2@example.com

DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token

WECHAT_ENABLED=false
WECHAT_CORP_ID=your_corp_id
WECHAT_CORP_SECRET=your_corp_secret
WECHAT_AGENT_ID=1000001

# 策略配置
STRATEGY_CONFIG_PATH=config/strategies