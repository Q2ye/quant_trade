# ==================== 环境配置 ====================
ENVIRONMENT=development
APP_NAME=量化交易平台
APP_VERSION=1.0.0

# ==================== 数据库配置 ====================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=quant_signals
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO_SQL=false
DB_ECHO_POOL=false

# ==================== API配置 ====================
APP_HOST=127.0.0.1
APP_PORT=8080
APP_DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# ==================== Redis配置 ====================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 数据源配置 ====================
TUSHARE_TOKEN=461a33c492dcfde47bbd2e87f67bd174399f354d34249d775809638b
TEST_ENV=false
SYNC_ENABLED=true

# ==================== 交易配置 ====================
SIMULATED_TRADING=true
SIM_INITIAL_CAPITAL=1000000
BROKER=XTP
MAX_POSITION_RATIO=0.8
STOP_LOSS_PERCENT=0.1

# ==================== 通知配置 ====================
EMAIL_ENABLED=false
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_RECEIVERS=user1@example.com,user2@example.com

DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token

WECHAT_ENABLED=false
WECHAT_CORP_ID=your_corp_id
WECHAT_CORP_SECRET=your_corp_secret
WECHAT_AGENT_ID=1000001

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

